{
  "name": "asimov",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "build": "tsc -b && vite build --config config/vite.config.ts",
    "preview": "vite preview --config config/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "infra:up": "docker compose up -d --build --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir frontend/module_bindings --module-path backend --yes",
    "spacetime:publish": "docker compose run --rm --build spacetime-publish",
    "spacetime:test": "node backend/tests/fleet_stats.test.ts",
    "e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "unit": "node --test frontend/lib/paging.test.ts",
    "simulator:test": "cargo test --release --manifest-path services/Cargo.toml -p asimov-simulator",
    "spacetime:generate:rust": "spacetime generate --lang rust --out-dir services/spacetime-ingest/src/module_bindings --module-path backend --yes",
    "services:test": "cargo test --manifest-path services/Cargo.toml --workspace --exclude asimov-simulator",
    "services:e2e": "cargo build --manifest-path services/Cargo.toml -p spacetime-ingest -p tdengine-ingest && cargo test --manifest-path services/Cargo.toml -p ingest-e2e -- --ignored --test-threads=1"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "spacetimedb": "2.10.*",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "~5.6.2",
    "vite": "^7.1.5"
  }
}
